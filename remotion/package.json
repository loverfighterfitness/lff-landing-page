{
  "name": "lff-remotion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Motion graphics for Lover Fighter Fitness short-form content",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render VolumeCurve out/volume-curve.mp4 --props='{\"transparentBackground\":false}'",
    "render:alpha": "remotion render VolumeCurve out/volume-curve.mov --codec=prores --prores-profile=4444 --image-format=png --pixel-format=yuva444p10le",
    "render:webm": "remotion render VolumeCurve out/volume-curve.webm --codec=vp8 --image-format=png --pixel-format=yuva420p",
    "still": "remotion still VolumeCurve out/frame.png --frame=330"
  },
  "dependencies": {
    "@remotion/cli": "4.0.525",
    "@remotion/fonts": "4.0.525",
    "@remotion/zod-types": "4.0.525",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.525",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
